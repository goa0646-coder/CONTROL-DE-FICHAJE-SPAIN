Options -Indexes
# Copias, volcados y registros nunca se sirven (app/ ya está cerrada entera con su propio .htaccess).
<FilesMatch "\.(sql|bak|log|md|ini|sh)$">
  Require all denied
</FilesMatch>
RewriteEngine On
# La API usa la cabecera Authorization: algunos servidores no la pasan a PHP sin esto.
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  # Estilos, código y la propia app: el navegador comprueba siempre si hay versión nueva.
  <FilesMatch "\.(css|js|php|html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
